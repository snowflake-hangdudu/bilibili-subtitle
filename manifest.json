{
  "manifest_version": 3,
  "name": "B站字幕提取助手",
  "version": "1.0.2",
  "description": "提取 B站视频已有字幕，清洗后可搜索并导出为 TXT / SRT / Markdown。",
  "permissions": ["storage", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://m.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://download-config-hub.nutmeg-venus-6882.chatgpt.site/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "19": "icons/icon19.png",
    "32": "icons/icon32.png",
    "38": "icons/icon38.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "B站字幕提取助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "19": "icons/icon19.png",
      "32": "icons/icon32.png",
      "38": "icons/icon38.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://m.bilibili.com/video/*"
      ],
      "js": ["src/content/wbi.js", "src/content/page-agent.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://m.bilibili.com/video/*"
      ],
      "js": ["src/content/content-boot.js"],
      "css": ["src/content/workspace-dock.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/popup.html",
        "src/workspace/workspace.html",
        "src/content/workspace-dock.js",
        "icons/icon128.png",
        "src/content/content.js",
        "src/features/subtitle/parser.js",
        "src/features/subtitle/cleaner.js",
        "src/features/video-context/detect.js",
        "src/features/video-context/track-bind.js",
        "src/platform/bilibili/adapter.js",
        "src/platform/bilibili/ids.js",
        "src/shared/errors.js",
        "src/shared/time.js",
        "src/shared/text.js"
      ],
      "matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ]
    }
  ]
}
